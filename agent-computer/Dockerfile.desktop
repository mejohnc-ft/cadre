# A real desktop for the Bot's computer, driven by Pi + agent-browser — the Grok-style experience.
#
# Built on the Playwright image (arm64 Chromium; Google Chrome ships no Linux arm64 build). Around
# it: a virtual display (Xvfb), a light window manager with a dock (openbox + tint2), a file manager
# (Thunar) and a terminal (xterm), streamed to the browser over noVNC — a real X11 clipboard, so
# copy/paste works. The agent is Pi: its loop drives a real, visible Chrome through agent-browser
# (Vercel Labs, CDP), the same window the person watches and can grab. Cadre authenticates and
# governs; Pi drives.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1
ENV DISPLAY_NUM=1
ENV WIDTH=1280
ENV HEIGHT=800
ENV IS_SANDBOX=1
ENV COMPUTER_DESKTOP=1

# The desktop, the apps, the VNC bridge.
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc xdotool scrot imagemagick \
      openbox tint2 xterm thunar dbus-x11 \
      python3 novnc websockify \
      unzip curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Bun + the Pi coding agent (and opencode/codex, matching the headless image), then the Pi browser
# extension. pi-agent-browser-native wraps Vercel Labs' agent-browser as a native Pi tool; installing
# it into Pi's global settings auto-enables it for every run.
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"
RUN bun add -g @mariozechner/pi-coding-agent opencode-ai @openai/codex \
      agent-browser \
    && ln -sf /root/.bun/bin/pi /usr/local/bin/pi \
    && ln -sf /root/.bun/bin/opencode /usr/local/bin/opencode || true
# Pi drives the browser with the agent-browser CLI through its bash tool — no extension (the
# published pi-agent-browser-native targets a different Pi fork). The CLI is version-matched and
# maintains a CDP session across calls.

WORKDIR /opt/agent-computer
COPY agent-computer/package.json agent-computer/bun.lock ./
RUN /root/.bun/bin/bun install --frozen-lockfile || /root/.bun/bin/bun install
COPY agent-computer/ ./
COPY agent-computer/hooks/ /opt/slice/
COPY agent-computer/desktop/ /opt/desktop/
RUN chmod +x /opt/desktop/*.sh /opt/desktop/cadre-cred 2>/dev/null || true; ln -sf /opt/desktop/cadre-cred /usr/local/bin/cadre-cred

# noVNC (the live screen) on 6080, the agent server on 4100.
EXPOSE 4100 6080

CMD ["/opt/desktop/start.sh"]
